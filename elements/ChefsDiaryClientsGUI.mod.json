      },
      {
        "type": "multiline_label",
        "data": {
          "name": "multiline_label_customers_visit_your_restaurant_copy",
          "text": "An empty stomach does not make anyone more patient. My guests can only wait so long for a table or their food.\nEach guest has their own patience. Serving one does not buy more time for the others.\nI should keep an eye on everyone at the table. A guest already enjoying their meal can finish it even when someone else runs out of patience.",
          "color": {
            "value": -12829636,
            "falpha": 0.0
          },
          "hasShadow": false,
